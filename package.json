{
  "name": "obsidian-opener",
  "displayName": "Obsidian Opener",
  "description": "在 Obsidian 中打开当前聚焦的 Markdown 文件（快捷键 + 编辑器右上角按钮）",
  "version": "0.3.0",
  "publisher": "leonezhu",
  "repository": {
    "type": "git",
    "url": "https://github.com/leonezhu/vscode-obsidian-opener.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "obsidian-opener.openInObsidian",
        "title": "Obsidian: 在 Obsidian 中打开当前文件",
        "icon": {
          "light": "icons/obsidian.svg",
          "dark": "icons/obsidian.svg"
        }
      }
    ],
    "keybindings": [
      {
        "command": "obsidian-opener.openInObsidian",
        "key": "alt+o",
        "mac": "cmd+alt+o",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "obsidian-opener.openInObsidian",
          "group": "navigation",
          "when": "editorLangId == markdown"
        }
      ]
    },
    "configuration": {
      "title": "Obsidian Opener",
      "properties": {
        "obsidianOpener.vaultName": {
          "type": "string",
          "default": "",
          "description": "Obsidian vault 名称。留空（推荐）时自动模式：用文件绝对路径由 Obsidian 匹配已注册 vault，不在任何 vault 内时按独立文件打开；填写后点击时会校验当前文档所在工作区根与该 vault 是否一致，一致才用 vault= 打开，否则按独立文件（path=）打开"
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
